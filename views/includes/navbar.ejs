<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border-radius: 25px;
    padding: 0 1rem 0 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }

  .search-btn:hover {
    background-color: #fe424d;
    color: #fff;
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem 0.5rem 3rem;
    font-size: 1rem;
  }
  
  .search-container {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }
   .navbar-toggler {
    width: 42px;
    height: 42px;
    border: none;
    border-radius: 50%;
    background-color: #f1f1f1;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
  }

  .navbar-toggler:hover {
    background-color: #e3e1e1;
  }

  .navbar-toggler-icon {
    width: 18px;
    height: 18px;
  }

  .navbar-toggler:focus, 
  .navbar-toggler:active {
    outline: none;
    box-shadow: none;
    border: none;
  }

  .dropdown-menu {
    background-color: #fff;
    border: 1px solid #f5f5f5;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .dropdown-divider {
    border-top: 1px solid #f1f1f1;
    opacity: 1;
}

  @media (max-width: 767px) {
    .search-container {
        position: static;
        transform: none;
        flex: 1;
        margin: 0 0.5rem;
        min-width: 0;
    }

    .search-container form {
        width: 100%;
    }

    .search-inp {
        min-width: 0;
        width: 100%;
    }
}

  @media (max-width: 576px) {
    .search-inp {
        padding: 0.4rem 1rem ;
        font-size: 0.85rem ;
    }
    .search-btn {
        padding: 0.5rem;
        padding-left: 0.5rem;
        font-size: 0.85rem;
    }
} 

@media (max-width: 400px) {
  .search-inp {
    padding: 0.4rem 0.5rem;
    width: 200px;
    font-size: 0.75rem;
  }
  .search-btn {
    padding-left: 0.5rem;
  }
}
</style>
<nav class="navbar navbar-expand-md bg-white border-bottom sticky-top">
  <div class="container-fluid">
    <a class="navbar-brand" href="/listings"><i class="fa-regular fa-compass"></i></a>

    <div class="navbar-nav search-container">
        <form class="d-flex" role="search" action="/listings" method="GET">
          <input 
          class="form-control me-2 search-inp" 
          type="search" 
          name="search"
          placeholder="Search destinations" 
          />
          <button class="btn search-btn" type="submit">
            <i class="fa-solid fa-magnifying-glass"></i> <span class="d-none d-md-inline">Search</span>
          </button>
        </form>
    </div>

    <!-- Desktop Navbar Links -->
<div class="navbar-nav ms-auto d-none d-md-flex">
  <a class="nav-link" href="/listings">Explore</a>
  <a class="nav-link" href="/listings/new">Airbnb your home</a>

  <% if(!currUser) { %>
    <a class="nav-link" href="/signup"><b>Sign up</b></a>
    <a class="nav-link" href="/login"><b>Log in</b></a>
  <% } %>

  <% if(currUser) { %>
    <a class="nav-link" href="/logout"><b>Log out</b></a>
  <% } %>
</div>


<!-- Mobile Hamburger -->
<div class="dropdown d-md-none">
  <button class="btn navbar-toggler" type="button" data-bs-toggle="dropdown" aria-expanded="false">
    <span class="navbar-toggler-icon"></span>
  </button>

  <ul class="dropdown-menu dropdown-menu-end">
    <li><a class="dropdown-item" href="/listings">Explore</a></li>
    <li><hr class="dropdown-divider"></li>
    <li><a class="dropdown-item" href="/listings/new">Airbnb your home</a></li>
    <li><hr class="dropdown-divider"></li>

    <% if(!currUser) { %>
      <li><a class="dropdown-item" href="/signup"><b>Sign up</b></a></li>
      <li><a class="dropdown-item" href="/login"><b>Log in</b></a></li>
    <% } %>

    <% if(currUser) { %>
      <li><a class="dropdown-item" href="/logout"><b>Log out</b></a></li>
    <% } %>
  </ul>
</div>

  </div>
</nav>